olumns:repeat(auto-fit,minmax(240px,1fr));gap:20px}\n  .step{background:var(--white);border:3px solid var(--line);padding:22px}\n  .step .sn{display:inline-block;font-size:12px;font-weight:800;letter-spacing:.14em;color:var(--violet);margin-bottom:10px}\n  .step h3{font-size:18px;font-weight:800;margin-bottom:8px;line-height:1.3}\n  .step p{font-size:14.5px;color:var(--ink-soft);line-height:1.7}\n\n  .clients{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px}\n  .client{background:var(--white);border:3px solid var(--line);padding:20px 22px}\n  .client h3{font-size:17px;font-weight:800;margin-bottom:6px}\n  .client .os{font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--violet);font-weight:700;margin-bottom:8px}\n  .client p{font-size:14px;color:var(--ink-soft);line-height:1.7}\n  .client .status{display:inline-block;margin-top:12px;font-size:12px;border:2px solid var(--line);padding:1px 8px;color:var(--ink-soft)}\n\n  .faq{display:flex;flex-direction:column;gap:14px}\n  .faq details{border:3px solid var(--line);background:var(--white)}\n  .faq details[open]{background:var(--violet-pale)}\n  .faq summary{cursor:pointer;list-style:none;padding:16px 46px 16px 20px;font-weight:800;font-size:16px;line-height:1.5;position:relative}\n  .faq summary::-webkit-details-marker{display:none}\n  .faq summary::after{content:\"+\";position:absolute;right:16px;top:50%;transform:translateY(-50%);width:22px;height:22px;line-height:20px;text-align:center;font-size:17px;font-weight:800;border:2px solid var(--line);background:var(--white)}\n  .faq details[open] summary::after{content:\"–\";background:var(--violet);color:var(--white)}\n  .faq .answer{padding:0 20px 20px;font-size:14.8px;line-height:1.75;color:var(--ink-soft);border-top:2px solid rgba(28,29,34,.14);margin-top:0;padding-top:14px}\n  .faq .answer p + p{margin-top:10px}\n\n  .note{margin-top:22px;background:var(--white);border:3px solid var(--line);border-left:12px solid var(--violet);padding:18px 22px;font-size:14px;line-height:1.75;color:var(--ink-soft)}\n\n  .foot{background:var(--ink);color:#c9cad3;padding:34px clamp(20px,5vw,64px) 40px;font-size:13.5px;line-height:1.8}\n  .foot strong{color:var(--white);font-size:15px;letter-spacing:.02em}\n  .foot a{color:#c9cad3;text-decoration:none;border-bottom:1px solid rgba(201,202,211,.5)}\n  .foot a:hover{color:var(--white);border-bottom-color:var(--white)}\n  .foot .row{display:flex;flex-wrap:wrap;gap:10px 26px;justify-content:space-between;align-items:baseline}\n  .foot p{max-width:46em;margin-top:10px}\n\n  @media (max-width:860px){\n    .shell{flex-direction:column}\n    .rail{position:static;width:auto;flex:0 0 auto;min-height:0;border-right:none;border-bottom:3px solid var(--line);padding:22px 20px 18px;gap:18px}\n    .rail-nav ul{flex-direction:row;flex-wrap:wrap;gap:6px}\n    .rail-nav a{padding:6px 8px;font-size:13.5px}\n    .rail-nav .idx{width:20px}\n    .rail-note{margin-top:0}\n    .band-meta{grid-template-columns:1fr}\n    .band-meta div{border-right:none;border-bottom:2px solid var(--line)}\n    .band-meta div:last-child{border-bottom:none}\n    .plan{grid-template-columns:1fr}\n    .plan.featured{box-shadow:6px 6px 0 var(--violet)}\n  }\n</style><div class=\"shell\">\n\n  <aside class=\"rail\">\n    <div class=\"rail-brand\">\n      <a href=\"#top\" class=\"mark\">CC云</a>\n      <span class=\"sub\">把方案讲明白，比堆形容词重要。</span>\n    </div>\n    <nav class=\"rail-nav\" aria-label=\"页面目录\">\n      <ul>\n        <li><a href=\"#top\"><span class=\"idx\">01</span>开头</a></li>\n        <li><a href=\"#plans\"><span class=\"idx\">02</span>订阅方案</a></li>\n        <li><a href=\"#how\"><span class=\"idx\">03</span>怎么用</a></li>\n        <li><a href=\"#clients\"><span class=\"idx\">04</span>客户端</a></li>\n        <li><a href=\"#faq\"><span class=\"idx\">05</span>常见问题</a></li>\n        <li><a href=\"#words\"><span class=\"idx\">06</span>几句实话</a></li>\n      </ul>\n    </nav>\n    <p class=\"rail-note\">页面里的价格和权益都写在正文中，方便你随时回来对照，不必翻聊天记录。</p>\n  </aside>\n\n  <div class=\"content\" id=\"top\">\n\n    <main>\n\n      <header class=\"hero\">\n        <div class=\"band band-top\">\n          <span class=\"dots\"><i></i><i></i><i></i></span>\n          <span>CC云 · 方案与使用说明</span>\n          <span>慢慢看，别急着选</span>\n        </div>\n\n        <div class=\"band band-main\">\n          <p class=\"eyebrow\">CC云 / 订阅与服务</p>\n          <h1>\n            CC云\n            <span class=\"thin\">三个档位，一份说明。先把价格、权益和使用步骤摆在一页上，再决定要不要开始。</span>\n          </h1>\n        </div>\n\n        <div class=\"band band-quote\">\n          <p>很多页面喜欢把话说满，我们试着反过来：把每档多少钱、给多少流量、能上几台设备，一条条写清楚。看完如果还拿不准，页尾的常见问题里大概有你正在想的那个问题。</p>\n        </div>\n\n        <dl class=\"band-meta\">\n          <div>\n            <dt>方案档位</dt>\n            <dd>基础版 / 旗舰版 / 团队版</dd>\n          </div>\n          <div>\n            <dt>计价方式</dt>\n            <dd>按月订阅，年付另有标价</dd>\n          </div>\n          <div>\n            <dt>适合谁</dt>\n            <dd>从个人日常到多人协作，各有对应一档</dd>\n          </div>\n        </dl>\n      </header>\n\n      <section id=\"plans\">\n        <div class=\"sec-head\">\n          <span class=\"num\">02</span>\n          <h2>三档订阅，逐条摊开</h2>\n        </div>\n        <p class=\"sec-lead\">每张卡片纵向排开，从上到下由轻到重。金额、流量、在线设备数都直接写在卡片里，年付价格附在月付下面，不藏着。</p>\n\n        <div class=\"plans\">\n\n          <article class=\"plan\">\n            <div>\n              <h3>基础版</h3>\n              <p class=\"price\">¥15<span> / 月</span></p>\n              <p class=\"annual\">按年付仅需 ¥150 / 年</p>\n            </div>\n            <div>\n              <ul>\n                <li>每月 100GB 极速流量</li>\n                <li>支持 3 台设备同时在线</li>\n                <li>解锁基础流媒体</li>\n                <li>普通线路节点池</li>\n              </ul>\n              <p class=\"plan-foot\">适合一个人日常用，手机加笔记本基本够占满三个在线名额。</p>\n            </div>\n          </article>\n\n          <article class=\"plan featured\">\n            <div>\n              <span class=\"tag\">多数人会看这档</span>\n              <h3>旗舰版</h3>\n              <p class=\"price\">¥35<span> / 月</span></p>\n              <p class=\"annual\">按年付仅需 ¥350 / 年</p>\n            </div>\n            <div>\n              <ul>\n                <li>每月 300GB 极速流量</li>\n                <li>支持 5 台设备同时在线</li>\n                <li>全节点原生流媒体解锁</li>\n                <li>IPLC 专线游戏加速优化</li>\n                <li>7x24 优先工单支持</li>\n              </ul>\n              <p class=\"plan-foot\">流量和在线设备都往上抬了一档，也多了优先工单这一条，适合家里几台设备轮着用的人。</p>\n            </div>\n          </article>\n\n          <article class=\"plan\">\n            <div>\n              <h3>团队版</h3>\n              <p class=\"price\">¥85<span> / 月</span></p>\n              <p class=\"annual\">按年付仅需 ¥850 / 年</p>\n            </div>\n            <div>\n              <ul>\n                <li>每月 1000GB 极速流量</li>\n                <li>支持 20 台设备同时在线</li>\n                <li>VIP 专属高带宽节点</li>\n                <li>支持企业定制路由</li>\n                <li>专属客户经理服务</li>\n              </ul>\n              <p class=\"plan-foot\">给一群人共用准备的，设备名额和流量都留了余量，另有定制路由和客户经理这两项对接。</p>\n            </div>\n          </article>\n\n        </div>\n\n        <p class=\"note\">说明一下：以上价格与权益为本页展示口径，实际下单时请以页面上当时显示的金额和条款为准。年付与月付的差额按标价计算，页面不额外承诺折扣或赠送。</p>\n      </section>\n\n      <section id=\"how\" class=\"tinted\">\n        <div class=\"sec-head\">\n          <span class=\"num\">03</span>\n          <h2>从挑档位到用起来</h2>\n        </div>\n        <p class=\"sec-lead\">流程不长，四步。每一步都写了你会看到什么、需要准备什么，照着走就行。</p>\n\n        <div class=\"steps\">\n          <div class=\"step\">\n            <span class=\"sn\">STEP 01</span>\n            <h3>先数设备，再看流量</h3>\n            <p>把每天要同时在线的设备列一下：手机、平板、电脑、电视盒子各算一台。数量定下来，档位基本就定了，再看每月流量够不够。</p>\n          </div>\n          <div class=\"step\">\n            <span class=\"sn\">STEP 02</span>\n            <h3>决定月付还是年付</h3>\n            <p>不确定会长期用，就先按月付走一个月。用顺手了再换年付，年付金额写在每张卡片的月价下方，可以直接对比。</p>\n          </div>\n          <div class=\"step\">\n            <span class=\"sn\">STEP 03</span>\n            <h3>装上客户端</h3>\n            <p>按你手上的设备选对应的客户端，参考下一节的说明。安装完成后按客户端里的提示完成配置，不要从别处复制来源不明的配置。</p>\n          </div>\n          <div class=\"step\">\n            <span class=\"sn\">STEP 04</span>\n            <h3>核对在线设备数</h3>\n            <p>连上之后看一眼同时在线设备有没有超出所选档位。超了就先下线一台，避免互相挤占，用起来也更稳当。</p>\n          </div>\n        </div>\n      </section>\n\n      <section id=\"clients\">\n        <div class=\"sec-head\">\n          <span class=\"num\">04</span>\n          <h2>客户端：按设备对号入座</h2>\n        </div>\n        <p class=\"sec-lead\">下面只说明各平台该找什么类型的客户端、注意什么。具体安装包与下载地址以官方渠道实际提供为准，本页不提供下载链接。</p>\n\n        <div class=\"clients\">\n          <article class=\"client\">\n            <p class=\"os\">Windows / macOS</p>\n            <h3>桌面端</h3>\n            <p>桌面系统上使用对应的图形客户端即可，安装后在客户端内完成配置。首次使用建议先只连一台设备，确认正常后再添其他设备。</p>\n            <span class=\"status\">安装包以官方渠道为准</span>\n          </article>\n          <article class=\"client\">\n            <p class=\"os\">iOS / Android</p>\n            <h3>移动端</h3>\n            <p>手机端按系统选择对应客户端。移动网络与 Wi-Fi 之间切换时，重新确认一次连接状态，避免以为连着其实没连上。</p>\n            <span class=\"status\">安装包以官方渠道为准</span>\n          </article>\n          <article class=\"client\">\n            <p class=\"os\">路由器 / 电视盒子</p>\n            <h3>家庭设备</h3>\n            <p>这类设备通常需要在设备自身的网络设置里完成配置，具体支持情况取决于设备型号与固件，建议先在电脑上验证可用再动手。</p>\n            <span class=\"status\">支持情况视设备而定</span>\n          </article>\n        </div>\n      </section>\n\n      <section id=\"faq\" class=\"tinted\">\n        <div class=\"sec-head\">\n          <span class=\"num\">05</span>\n          <h2>常见问题，点开看</h2>\n        </div>\n        <p class=\"sec-lead\">下面是问得比较多的几条。没找到答案的，可以带着具体设备和使用场景来问，描述越具体越好回答。</p>\n\n        <div class=\"faq\">\n\n          <details>\n            <summary>基础版和旗舰版，到底差在哪里？</summary>\n            <div class=\"answer\">\n              <p>主要在三个地方：流量从每月 100GB 到 300GB；同时在线设备从 3 台到 5 台；流媒体解锁范围从基础扩大到全节点原生，另外旗舰版多了 IPLC 专线游戏加速优化和 7x24 优先工单支持。</p>\n              <p>如果只是一个人一两台设备日常使用，基础版通常就够；如果家里有多台设备轮着上，或者在意游戏线路和优先支持，再看旗舰版。</p>\n            </div>\n          </details>\n\n          <details>\n            <summary>我该选月付还是年付？</summary>\n            <div class=\"answer\">\n              <p>先用一个月试试是最稳的做法。用下来觉得合适，再考虑年付。年付金额直接写在每张卡片的月价下面：基础版 ¥150 / 年，旗舰版 ¥350 / 年，团队版 ¥850 / 年，与月付的对应关系一眼能算清。</p>\n              <p>如果使用频率不确定、或者只是短期需要，月付更灵活，不必为了省一点而提前押上一整年。</p>\n            </div>\n          </details>\n\n          <details>\n            <summary>在线设备数是怎么算的？超了会怎样？</summary>\n            <div class=\"answer\">\n              <p>按\"同时在线\"计算。手机、平板、电脑、电视盒子各算一台，同一时间连着的设备数不能超过所选档位：基础版 3 台、旗舰版 5 台、团队版 20 台。</p>\n              <p>超出时建议先下线不用的设备。养成用完就断的习惯，日常基本不会碰到上限。</p>\n            </div>\n          </details>\n\n          <details>\n            <summary>流量每月怎么计算，会累积吗？</summary>\n            <div class=\"answer\">\n              <p>各档位标的是每月流量额度：100GB、300GB、1000GB。按自然月计的额度通常不累积到下一月，具体以你下单时页面上的条款为准。</p>\n              <p>如果你不确定自己一个月会用多少，可以先从基础版开始，看一个月的实际用量再决定要不要升档，比凭感觉猜要准。</p>\n            </div>\n          </details>\n\n          <details>\n            <summary>团队版里的\"企业定制路由\"和\"专属客户经理\"是什么意思？</summary>\n            <div class=\"answer\">\n              <p>这两项是团队版独有的对接方式：定制路由指可以就团队的网络使用场景提出具体需求，由对接方评估可行的配置方式；专属客户经理指团队版有一条固定的对接人渠道，不用和普通工单一起排队。</p>\n              <p>具体能定制到什么程度，取决于你团队的实际场景，建议在下单前先把需求说清楚再确认。</p>\n            </div>\n          </details>\n\n          <details>\n            <summary>支持哪些设备？找不到客户端怎么办？</summary>\n            <div class=\"answer\">\n              <p>桌面端（Windows / macOS）和移动端（iOS / Android）都有对应的图形客户端可用。路由器、电视盒子这类设备通常需要在设备自身的网络设置里完成配置，是否可行取决于型号和固件。</p>\n              <p>本页不提供任何安装包或下载链接，请以官方渠道实际提供的版本为准，不要安装来源不明的安装包。</p>\n            </div>\n          </details>\n\n          <details>\n            <summary>用着不顺手，能换档位吗？</summary>\n            <div class=\"answer\">\n              <p>档位之间是可以调整的，但怎么调、补多少差价、从什么时候生效，属于下单页面上写明的事项，本页不代为承诺。建议在调整前先看清当时的页面说明。</p>\n              <p>如果只是偶尔不够用，先确认是不是有设备在后台占着流量，往往比直接升档更省事。</p>\n            </div>\n          </details>\n\n        </div>\n      </section>\n\n      <section id=\"words\">\n        <div class=\"sec-head\">\n          <span class=\"num\">06</span>\n          <h2>几句实话</h2>\n        </div>\n        <p class=\"sec-lead\">这页不打算说服你什么，只把该说的说在前面。</p>\n\n        <div class=\"card\">\n          <p>第一，价格和权益本页都写全了，但下单时的页面才是最终依据，两者若有不一致，以下单页面为准。</p>\n          <p>第二，我们不在本页做速度、节点数量、稳定性之类的量化承诺，也不写用户评价。这些你更适合自己在试用期内判断。</p>\n          <p>第三，客户端安装包请只从官方渠道获取。任何来源不明的安装包都不建议使用，这条和用哪个档位无关，属于基本习惯。</p>\n          <p>第四，拿不准就先选基础版，用一个月。选小了可以再调，一上来选大了反而浪费。</p>\n        </div>\n      </section>\n\n    </main>\n\n    <footer class=\"foot\">\n      <div class=\"row\">\n        <strong>CC云</strong>\n        <span><a href=\"#plans\">回到订阅方案</a> · <a href=\"#faq\">查看常见问题</a> · <a href=\"#top\">回到开头</a></span>\n      </div>\n      <p>本页为 CC云 的方案与使用说明页面，内容以静态文字呈现，价格、权益与流程以实际下单页面所载条款为准。</p>\n    </footer>\n\n  </div>\n</div>",
