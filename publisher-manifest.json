          "version": 3,
          "body": "<style>\n  :root{--paper:#f2f3f6;--paper-deep:#e7e9ef;--ink:#1c1d22;--ink-soft:#4a4d57;--violet:#6f3ff5;--violet-pale:#ece6ff;--line:#1c1d22;--white:#ffffff}\n  *{box-sizing:border-box}\n  html{}\n  body{margin:0;background:var(--paper);color:var(--ink);font-family:\"Helvetica Neue\",\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",sans-serif;font-size:16px;line-height:1.7;-webkit-font-smoothing:antialiased}\n  a{color:inherit}\n  h1,h2,h3,p,ul,ol{margin:0}\n  ul,ol{padding:0;list-style:none}\n\n  .shell{display:flex;align-items:flex-start;min-height:100vh}\n\n  /* 左侧竖排目录 */\n  .rail{position:sticky;top:0;width:236px;flex:0 0 236px;align-self:stretch;min-height:100vh;background:var(--white);border-right:3px solid var(--line);padding:34px 26px 40px;display:flex;flex-direction:column;gap:30px}\n  .rail-brand{display:block}\n  .rail-brand .mark{display:inline-block;background:var(--violet);color:var(--white);font-weight:800;font-size:20px;letter-spacing:.04em;padding:6px 12px;border:2px solid var(--line)}\n  .rail-brand .sub{display:block;margin-top:12px;font-size:12px;line-height:1.6;color:var(--ink-soft);letter-spacing:.02em}\n  .rail-nav ul{display:flex;flex-direction:column;gap:4px}\n  .rail-nav a{display:block;text-decoration:none;padding:8px 10px;border:2px solid transparent;font-size:14.5px;color:var(--ink-soft);letter-spacing:.02em;transition:background .15s ease,border-color .15s ease,color .15s ease}\n  .rail-nav a:hover,\n  .rail-nav a:focus{background:var(--violet-pale);border-color:var(--line);color:var(--ink)}\n  .rail-nav .idx{display:inline-block;width:24px;font-variant-numeric:tabular-nums;font-weight:700;color:var(--violet)}\n  .rail-note{margin-top:auto;border-top:2px solid var(--line);padding-top:16px;font-size:12.5px;line-height:1.65;color:var(--ink-soft)}\n\n  .content{flex:1 1 auto;min-width:0}\n\n  /* 首屏：全宽色带分层堆叠 */\n  .hero{border-bottom:3px solid var(--line)}\n  .band{padding:0 clamp(20px,5vw,64px)}\n  .band-top{background:var(--white);border-bottom:2px solid var(--line);display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;padding-top:16px;padding-bottom:16px;font-size:12.5px;letter-spacing:.14em;color:var(--ink-soft);text-transform:uppercase}\n  .band-top .dots{display:inline-flex;gap:6px;align-items:center}\n  .band-top .dots i{display:block;width:9px;height:9px;background:var(--violet);border:2px solid var(--line)}\n  .band-main{background:var(--paper-deep);padding-top:clamp(36px,6vw,68px);padding-bottom:clamp(36px,6vw,64px);border-bottom:2px solid var(--line)}\n  .band-main .eyebrow{font-size:13px;letter-spacing:.22em;font-weight:700;color:var(--violet);text-transform:uppercase;margin-bottom:18px}\n  h1{font-size:clamp(38px,7.4vw,82px);line-height:1.02;font-weight:800;letter-spacing:-.02em;max-width:15em}\n  h1 .thin{display:block;font-weight:400;font-size:.42em;line-height:1.35;letter-spacing:0;margin-top:20px;max-width:24em;color:var(--ink-soft)}\n  .band-quote{background:var(--violet);color:var(--white);padding-top:22px;padding-bottom:22px;border-bottom:2px solid var(--line)}\n  .band-quote p{max-width:44em;font-size:clamp(15px,1.7vw,18px);line-height:1.65}\n  .band-meta{background:var(--white);display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;padding:0;border-bottom:2px solid var(--line)}\n  .band-meta div{padding:22px clamp(16px,3vw,34px);border-right:2px solid var(--line)}\n  .band-meta div:last-child{border-right:none}\n  .band-meta dt{font-size:11.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:6px}\n  .band-meta dd{margin:0;font-weight:700;font-size:15px;line-height:1.5}\n\n  section{padding:clamp(40px,6vw,76px) clamp(20px,5vw,64px);border-bottom:3px solid var(--line);background:var(--white)}\n  section.tinted{background:var(--paper-deep)}\n  section:last-of-type{border-bottom:none}\n\n  .sec-head{display:flex;flex-wrap:wrap;align-items:baseline;gap:14px 22px;margin-bottom:clamp(2